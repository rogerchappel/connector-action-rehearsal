{
  "name": "connector-action-rehearsal",
  "version": "0.1.0",
  "description": "Local-first CLI and agent skill for rehearsing connector write actions before approval.",
  "type": "module",
  "bin": {
    "connector-action-rehearsal": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "docs",
    "fixtures",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "node dist/src/cli.js plan fixtures/meeting-followup.json --format markdown --fail-on forbidden",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:check": "bash scripts/validate.sh",
    "validate": "npm run release:check",
    "lint": "npm run check"
  },
  "keywords": [
    "agent-skills",
    "connectors",
    "dry-run",
    "approval",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-action-rehearsal.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-action-rehearsal/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-action-rehearsal#readme"
}
